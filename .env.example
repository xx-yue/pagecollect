# 复制为 .env 后按需修改。
# 注意：不要把 .env 提交到版本库（.gitignore 已排除）。

# ---------- 基本信息 ----------
DEBUG=true

# ---------- 大模型 ----------
# true  = 使用内置 mock，不联网、不花钱，可跑通全链路（首次体验建议保持 true）
# false = 调用真实多模态模型
MOCK_LLM=true

# OpenAI 兼容端点。常见国内厂商（按需替换）：
#   通义千问  https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱 GLM  https://open.bigmodel.cn/api/paas/v4
#   豆包      https://ark.cn-beijing.volces.com/api/v3
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-vl-max

# 并发页数。受厂商 RPM 限制约束，建议 3~8；调太高会频繁触发限流
LLM_CONCURRENCY=5
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# ---------- PDF 处理 ----------
# 页面渲染分辨率。150 对正文识别足够，再高只是白烧 token
RENDER_DPI=150
JPEG_QUALITY=85
# 文本层字符数阈值：超过则走纯文本链路，成本约为多模态的 1/10
TEXT_LAYER_MIN_CHARS=50

# ---------- 排序 ----------
# 排序结果非法（非全排列）时的最大重试次数
ORDER_MAX_ATTEMPTS=3
# 整体置信度低于该值时，客户端标记「需人工复核」
LOW_CONFIDENCE_THRESHOLD=0.7
